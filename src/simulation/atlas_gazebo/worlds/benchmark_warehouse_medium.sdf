<?xml version="1.0"?>
<sdf version="1.11">
  <world name="benchmark_warehouse_medium">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>70 70</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>70 70</size></plane></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual></link></model>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 12 0 0 0</pose><diffuse>0.85 0.85 0.85 1</diffuse><direction>-0.4 0.2 -0.9</direction></light>

    <model name="wall_north"><static>true</static><pose>0 14 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>28.4 0.2 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>28.4 0.2 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -14 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>28.4 0.2 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>28.4 0.2 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>14 0 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 28.0 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 28.0 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-14 0 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 28.0 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 28.0 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>

    <include><name>shelf_medium_01</name><uri>model://warehouse_shelf</uri><pose>-8 6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_02</name><uri>model://warehouse_shelf</uri><pose>-8 0 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_03</name><uri>model://warehouse_shelf</uri><pose>-8 -6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_04</name><uri>model://warehouse_shelf</uri><pose>0 6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_05</name><uri>model://warehouse_shelf</uri><pose>0 1.8 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_06</name><uri>model://warehouse_shelf</uri><pose>0 -6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_07</name><uri>model://warehouse_shelf</uri><pose>8 6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_08</name><uri>model://warehouse_shelf</uri><pose>8 0 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_09</name><uri>model://warehouse_shelf</uri><pose>8 -6 0 0 0 1.5708</pose></include>
    <include><name>pallet_medium_01</name><uri>model://warehouse_pallet</uri><pose>-4 -9 0 0 0 0.4</pose></include>
    <include><name>pallet_medium_02</name><uri>model://warehouse_pallet</uri><pose>4 9 0 0 0 -0.2</pose></include>
    <include><name>box_cluster_medium_01</name><uri>model://warehouse_box_cluster</uri><pose>5 -4 0 0 0 0.3</pose></include>
    <include><name>trash_bin_medium_01</name><uri>model://warehouse_trash_bin</uri><pose>-5 4 0 0 0 0</pose></include>
    <include><name>pallet_jack_medium_01</name><uri>model://warehouse_pallet_jack</uri><pose>10 -10 0 0 0 0.8</pose></include>
    <include><name>floor_marking_medium_01</name><uri>model://warehouse_floor_marking</uri><pose>-4 12 0 0 0 0</pose></include>
    <include><name>floor_marking_medium_02</name><uri>model://warehouse_floor_marking</uri><pose>0 12 0 0 0 0</pose></include>
    <include><name>floor_marking_medium_03</name><uri>model://warehouse_floor_marking</uri><pose>4 12 0 0 0 0</pose></include>
  </world>
</sdf>
