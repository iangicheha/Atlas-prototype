<?xml version="1.0"?>
<sdf version="1.11">
  <world name="benchmark_warehouse_easy">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry><material><ambient>0.58 0.58 0.60 1</ambient><diffuse>0.58 0.58 0.60 1</diffuse></material></visual></link></model>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.85 0.85 0.85 1</diffuse><direction>-0.4 0.2 -0.9</direction></light>

    <model name="wall_north"><static>true</static><pose>0 10 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>20.4 0.2 2.5</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -10 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>20.4 0.2 2.5</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>10 0 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 20.0 2.5</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-10 0 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 20.0 2.5</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>

    <include><name>shelf_easy_01</name><uri>model://warehouse_shelf</uri><pose>-4 4 0 0 0 0</pose></include>
    <include><name>shelf_easy_02</name><uri>model://warehouse_shelf</uri><pose>4 4 0 0 0 0</pose></include>
    <include><name>pallet_easy_01</name><uri>model://warehouse_pallet</uri><pose>0 -2 0 0 0 0.2</pose></include>
    <include><name>box_cluster_easy_01</name><uri>model://warehouse_box_cluster</uri><pose>5 -5 0 0 0 0</pose></include>
    <include><name>charging_dock_easy_01</name><uri>model://charging_dock</uri><pose>-7 -7 0 0 0 0</pose></include>
  </world>
</sdf>
