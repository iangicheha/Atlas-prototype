<?xml version="1.0"?>
<sdf version="1.11">
  <world name="benchmark_warehouse_hard">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry><material><ambient>0.53 0.53 0.55 1</ambient><diffuse>0.53 0.53 0.55 1</diffuse></material></visual></link></model>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 12 0 0 0</pose><diffuse>0.82 0.82 0.82 1</diffuse><direction>-0.4 0.2 -0.9</direction></light>

    <model name="wall_north"><static>true</static><pose>0 16 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>32.4 0.2 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>32.4 0.2 3.0</size></box></geometry><material><ambient>0.80 0.80 0.82 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -16 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>32.4 0.2 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>32.4 0.2 3.0</size></box></geometry><material><ambient>0.80 0.80 0.82 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>16 0 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 32.0 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 32.0 3.0</size></box></geometry><material><ambient>0.80 0.80 0.82 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-16 0 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 32.0 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 32.0 3.0</size></box></geometry><material><ambient>0.80 0.80 0.82 1</ambient><diffuse>0.80 0.80 0.82 1</diffuse></material></visual></link></model>

    <include><name>shelf_hard_01</name><uri>model://warehouse_shelf</uri><pose>-10 9 0 0 0 1.5708</pose></include>
